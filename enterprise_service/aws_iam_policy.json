{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowSQSManagement",
            "Effect": "Allow",
            "Action": [
                "sqs:CreateQueue",
                "sqs:GetQueueAttributes",
                "sqs:SetQueueAttributes",
                "sqs:ReceiveMessage",
                "sqs:DeleteMessage",
                "sqs:GetQueueUrl"
            ],
            "Resource": "arn:aws:sqs:us-east-1:*:smartie-indexing-queue"
        },
        {
            "Sid": "AllowS3Management",
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket",
                "s3:ListBucket",
                "s3:PutObject",
                "s3:GetObject",
                "s3:DeleteObject",
                "s3:PutBucketNotification",
                "s3:GetBucketNotification"
            ],
            "Resource": [
                "arn:aws:s3:::smartie-dev-docs-*",
                "arn:aws:s3:::smartie-dev-docs-*/*"
            ]
        }
    ]
}
